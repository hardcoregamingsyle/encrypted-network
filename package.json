{
  "name": "hrdlock",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "signed document and file system with a chat network, runs on Cloudflare Pages",
  "scripts": {
    "dev:web": "vite",
    "dev:api": "wrangler pages dev --proxy 5173 --port 8788 --d1 DB --r2 FILES",
    "build": "node scripts/check-node.mjs && vite build",
    "preview": "vite build && wrangler pages dev dist --port 8788 --d1 DB --r2 FILES",
    "setup": "node scripts/setup-dev.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "takedown": "node scripts/takedown.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
